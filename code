-- ================= VIEWS =================
CREATE VIEW v_active_members AS
SELECT m.member_id, m.name, m.phone, p.plan_name, s.end_date
  FROM Member m JOIN Subscription s ON s.member_id = m.member_id
  JOIN Plan p ON p.plan_id = s.plan_id
 WHERE s.status='ACTIVE' AND CURDATE() BETWEEN s.start_date AND s.end_date;

CREATE VIEW v_expired_members AS            -- nested query
SELECT m.member_id, m.name, m.phone,
       (SELECT MAX(end_date) FROM Subscription s WHERE s.member_id=m.member_id) AS last_end_date
  FROM Member m
 WHERE NOT EXISTS (SELECT 1 FROM Subscription s
                    WHERE s.member_id=m.member_id AND s.status='ACTIVE'
                      AND CURDATE() BETWEEN s.start_date AND s.end_date);

CREATE VIEW v_class_attendance AS
SELECT sc.schedule_id, c.class_name, sc.class_date, c.capacity,
       COUNT(r.reg_id) AS registered,
       COALESCE(SUM(a.attended),0) AS attended
  FROM Schedule sc JOIN Class c ON c.class_id = sc.class_id
  LEFT JOIN Registration r ON r.schedule_id = sc.schedule_id AND r.status='BOOKED'
  LEFT JOIN Attendance a ON a.reg_id = r.reg_id
 GROUP BY sc.schedule_id, c.class_name, sc.class_date, c.capacity;

CREATE VIEW v_trainer_load AS
SELECT t.trainer_id, t.name, t.specialization,
       (SELECT COUNT(*) FROM Member m WHERE m.trainer_id=t.trainer_id) AS members_assigned,
       (SELECT COUNT(*) FROM Schedule s WHERE s.trainer_id=t.trainer_id) AS classes_scheduled
  FROM Trainer t;

CREATE VIEW v_maintenance_due AS
SELECT e.equip_id, e.name, e.status, MAX(mt.next_due_date) AS next_due,
       DATEDIFF(MAX(mt.next_due_date), CURDATE()) AS days_left
  FROM Equipment e JOIN Maintenance mt ON mt.equip_id = e.equip_id
 GROUP BY e.equip_id, e.name, e.status;

CREATE VIEW v_revenue_monthly AS
SELECT DATE_FORMAT(pay_date,'%Y-%m') AS month, COUNT(*) AS payments, SUM(amount) AS revenue
  FROM Payment GROUP BY DATE_FORMAT(pay_date,'%Y-%m');


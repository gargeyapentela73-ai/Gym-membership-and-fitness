-- Gym Membership & Fitness Session Management System (MySQL 8)
-- Run: mysql -u root -p < schema.sql
DROP DATABASE IF EXISTS gym_db;
CREATE DATABASE gym_db;
USE gym_db;

-- ================= TABLES (3NF) =================
CREATE TABLE Plan (
  plan_id INT AUTO_INCREMENT PRIMARY KEY,
  plan_name VARCHAR(50) NOT NULL UNIQUE,
  duration_days INT NOT NULL CHECK (duration_days > 0),
  price DECIMAL(10,2) NOT NULL CHECK (price >= 0)
);

CREATE TABLE Trainer (
  trainer_id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(80) NOT NULL,
  phone VARCHAR(15) NOT NULL UNIQUE,
  specialization VARCHAR(50) NOT NULL,
  hire_date DATE NOT NULL DEFAULT (CURRENT_DATE)
);

CREATE TABLE Member (
  member_id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(80) NOT NULL,
  phone VARCHAR(15) NOT NULL UNIQUE,
  email VARCHAR(100) UNIQUE,
  dob DATE NOT NULL,
  gender ENUM('M','F','O') NOT NULL,
  join_date DATE NOT NULL DEFAULT (CURRENT_DATE),
  trainer_id INT NULL,
  FOREIGN KEY (trainer_id) REFERENCES Trainer(trainer_id) ON DELETE SET NULL
);

CREATE TABLE Subscription (
  sub_id INT AUTO_INCREMENT PRIMARY KEY,
  member_id INT NOT NULL,
  plan_id INT NOT NULL,
  start_date DATE NOT NULL,
  end_date DATE NOT NULL,
  status ENUM('ACTIVE','CANCELLED') NOT NULL DEFAULT 'ACTIVE',
  CHECK (end_date > start_date),
  FOREIGN KEY (member_id) REFERENCES Member(member_id) ON DELETE CASCADE,
  FOREIGN KEY (plan_id) REFERENCES Plan(plan_id)
);

CREATE TABLE Payment (
  payment_id INT AUTO_INCREMENT PRIMARY KEY,
  sub_id INT NOT NULL,
  amount DECIMAL(10,2) NOT NULL CHECK (amount > 0),
  pay_date DATE NOT NULL DEFAULT (CURRENT_DATE),
  mode ENUM('CASH','UPI','CARD') NOT NULL DEFAULT 'UPI',
  FOREIGN KEY (sub_id) REFERENCES Subscription(sub_id) ON DELETE CASCADE
);

CREATE TABLE Renewal (
  renewal_id INT AUTO_INCREMENT PRIMARY KEY,
  sub_id INT NOT NULL,
  old_end_date DATE NOT NULL,
  new_end_date DATE NOT NULL,
  renewal_date DATE NOT NULL DEFAULT (CURRENT_DATE),
  CHECK (new_end_date > old_end_date),          -- valid renewal dates
  FOREIGN KEY (sub_id) REFERENCES Subscription(sub_id) ON DELETE CASCADE
);

CREATE TABLE Assessment (
  assess_id INT AUTO_INCREMENT PRIMARY KEY,
  member_id INT NOT NULL,
  trainer_id INT NOT NULL,
  assess_date DATE NOT NULL DEFAULT (CURRENT_DATE),
  weight DECIMAL(5,2) NOT NULL CHECK (weight > 0),
  height DECIMAL(5,2) NOT NULL CHECK (height > 0),
  bmi DECIMAL(5,2) NOT NULL CHECK (bmi >= 0),     -- non-negative values
  body_fat DECIMAL(5,2) NOT NULL CHECK (body_fat >= 0 AND body_fat <= 100),
  FOREIGN KEY (member_id) REFERENCES Member(member_id) ON DELETE CASCADE,
  FOREIGN KEY (trainer_id) REFERENCES Trainer(trainer_id)
);

CREATE TABLE WorkoutProgramme (
  programme_id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(80) NOT NULL UNIQUE,
  goal VARCHAR(100) NOT NULL,
  duration_weeks INT NOT NULL CHECK (duration_weeks > 0)
);

CREATE TABLE MemberProgramme (
  member_id INT NOT NULL,
  programme_id INT NOT NULL,
  start_date DATE NOT NULL,
  end_date DATE NULL,
  PRIMARY KEY (member_id, programme_id, start_date),
  FOREIGN KEY (member_id) REFERENCES Member(member_id) ON DELETE CASCADE,
  FOREIGN KEY (programme_id) REFERENCES WorkoutProgramme(programme_id)
);

CREATE TABLE Class (
  class_id INT AUTO_INCREMENT PRIMARY KEY,
  class_name VARCHAR(60) NOT NULL UNIQUE,
  description VARCHAR(200),
  capacity INT NOT NULL CHECK (capacity > 0)       -- class-capacity limit
);

CREATE TABLE Schedule (
  schedule_id INT AUTO_INCREMENT PRIMARY KEY,
  class_id INT NOT NULL,
  trainer_id INT NOT NULL,
  class_date DATE NOT NULL,
  start_time TIME NOT NULL,
  end_time TIME NOT NULL,
  room VARCHAR(30) NOT NULL,
  CHECK (end_time > start_time),
  FOREIGN KEY (class_id) REFERENCES Class(class_id),
  FOREIGN KEY (trainer_id) REFERENCES Trainer(trainer_id)
);

CREATE TABLE Registration (
  reg_id INT AUTO_INCREMENT PRIMARY KEY,
  member_id INT NOT NULL,
  schedule_id INT NOT NULL,
  reg_date DATE NOT NULL DEFAULT (CURRENT_DATE),
  status ENUM('BOOKED','CANCELLED') NOT NULL DEFAULT 'BOOKED',
  UNIQUE (member_id, schedule_id),
  FOREIGN KEY (member_id) REFERENCES Member(member_id) ON DELETE CASCADE,
  FOREIGN KEY (schedule_id) REFERENCES Schedule(schedule_id) ON DELETE CASCADE
);

CREATE TABLE Attendance (
  attendance_id INT AUTO_INCREMENT PRIMARY KEY,
  reg_id INT NOT NULL UNIQUE,
  attended BOOLEAN NOT NULL DEFAULT TRUE,
  check_in_time TIME NULL,
  FOREIGN KEY (reg_id) REFERENCES Registration(reg_id) ON DELETE CASCADE
);

CREATE TABLE Equipment (
  equip_id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(60) NOT NULL,
  category VARCHAR(40) NOT NULL,
  purchase_date DATE NOT NULL,
  status ENUM('WORKING','UNDER_MAINTENANCE','RETIRED') NOT NULL DEFAULT 'WORKING'
);

CREATE TABLE Maintenance (
  maint_id INT AUTO_INCREMENT PRIMARY KEY,
  equip_id INT NOT NULL,
  maint_date DATE NOT NULL DEFAULT (CURRENT_DATE),
  description VARCHAR(200) NOT NULL,
  cost DECIMAL(10,2) NOT NULL DEFAULT 0 CHECK (cost >= 0),
  next_due_date DATE NOT NULL,
  CHECK (next_due_date > maint_date),
  FOREIGN KEY (equip_id) REFERENCES Equipment(equip_id) ON DELETE CASCADE
);

-- ================= INDEXES =================
CREATE INDEX idx_member_name   ON Member(name);
CREATE INDEX idx_sub_member    ON Subscription(member_id, end_date);
CREATE INDEX idx_sched_date    ON Schedule(class_date, trainer_id);
CREATE INDEX idx_reg_schedule  ON Registration(schedule_id);
CREATE INDEX idx_maint_due     ON Maintenance(next_due_date);

-- ================= TRIGGERS (business rules) =================
DELIMITER $$

-- Rule: active subscription required + class-capacity limit
CREATE TRIGGER trg_registration_check BEFORE INSERT ON Registration
FOR EACH ROW
BEGIN
  DECLARE v_date DATE; DECLARE v_cap INT; DECLARE v_booked INT; DECLARE v_active INT;
  SELECT s.class_date, c.capacity INTO v_date, v_cap
    FROM Schedule s JOIN Class c ON c.class_id = s.class_id
   WHERE s.schedule_id = NEW.schedule_id;

  SELECT COUNT(*) INTO v_active FROM Subscription
   WHERE member_id = NEW.member_id AND status = 'ACTIVE'
     AND v_date BETWEEN start_date AND end_date;
  IF v_active = 0 THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Member has no active subscription on the class date';
  END IF;

  SELECT COUNT(*) INTO v_booked FROM Registration
   WHERE schedule_id = NEW.schedule_id AND status = 'BOOKED';
  IF NEW.status = 'BOOKED' AND v_booked >= v_cap THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Class is full (capacity reached)';
  END IF;
END$$

-- Rule: no trainer overlap
CREATE TRIGGER trg_schedule_overlap BEFORE INSERT ON Schedule
FOR EACH ROW
BEGIN
  IF EXISTS (SELECT 1 FROM Schedule
              WHERE trainer_id = NEW.trainer_id AND class_date = NEW.class_date
                AND start_time < NEW.end_time AND end_time > NEW.start_time) THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Trainer already has a class in this time slot';
  END IF;
END$$

-- Rule: renewal must start from the subscription's current end date
CREATE TRIGGER trg_renewal_check BEFORE INSERT ON Renewal
FOR EACH ROW
BEGIN
  DECLARE v_end DATE;
  SELECT end_date INTO v_end FROM Subscription WHERE sub_id = NEW.sub_id;
  IF NEW.old_end_date <> v_end THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'old_end_date does not match subscription end date';
  END IF;
END$$

DELIMITER ;

